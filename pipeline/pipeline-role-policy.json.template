{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "RunPipelineSteps", "Effect": "Allow",
     "Action": ["sagemaker:CreateProcessingJob", "sagemaker:DescribeProcessingJob",
                "sagemaker:StopProcessingJob", "sagemaker:CreateTrainingJob",
                "sagemaker:DescribeTrainingJob", "sagemaker:StopTrainingJob",
                "sagemaker:CreateModelPackage", "sagemaker:DescribeModelPackage",
                "sagemaker:DescribeModelPackageGroup"], "Resource": "*"},
    {"Sid": "PassWorkloadRole", "Effect": "Allow", "Action": "iam:PassRole",
     "Resource": "${SAGEMAKER_ROLE_ARN}",
     "Condition": {"StringEquals": {"iam:PassedToService": "sagemaker.amazonaws.com"}}}
  ]
}
